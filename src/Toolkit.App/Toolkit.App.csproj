<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Toolkit</AssemblyName>
    <RootNamespace>Toolkit.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <!-- Identidad de la app: Propiedades > Detalles del exe, dialogo Acerca de y ayuda de consola. -->
    <Authors>danielnvcd</Authors>
    <Company>danielnvcd</Company>
    <Copyright>Copyright (c) 2026 danielnvcd</Copyright>
    <Description>Toolkit BPO - utilidades de soporte tecnico para call center: ubicacion, aplicaciones, red, usuarios y reparaciones rapidas.</Description>
    <Product>Toolkit BPO</Product>
    <AssemblyTitle>Toolkit BPO</AssemblyTitle>
    <!-- Icono del exe (Explorador, barra de tareas). Se genera desde assets\logo.svg con scripts\tools\New-Logo.ps1 -->
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <!-- Sin ventana de consola propia: en modo CLI se engancha a la del padre (Program.cs) -->
    <DebugType>embedded</DebugType>

    <!--
      PORTABLE: el entregable es SOLO Toolkit.exe. Nada de .pdb, .config ni DLLs al lado.
        - DebugType embedded            -> los simbolos van dentro del exe
        - sin binding redirects/config  -> no se genera Toolkit.exe.config
        - Deterministic                 -> el mismo codigo produce el mismo binario (hash reproducible)
      Todo lo que necesita en tiempo de ejecucion (.NET Framework 4.8, PowerShell 5.1,
      System.DirectoryServices, WinForms) viene de fabrica en Windows 10/11.
    -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Ensamblados de referencia de Windows PowerShell 5.1.
      No se distribuye ninguna DLL: en tiempo de ejecucion resuelve contra la
      System.Management.Automation del GAC, presente en todo Windows 10/11.
      ExcludeAssets=runtime evita que el SDK copie esas DLL a bin\ (romperia
      la regla de "un solo archivo" y engordaria el exe sin aportar nada).
    -->
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <!-- System.DirectoryServices lo usa Toolkit.Users.psm1 (ADSI) dentro del runspace; esta en el GAC. -->
    <Reference Include="System.DirectoryServices" />
  </ItemGroup>

  <ItemGroup>
    <!--
      AQUI ES DONDE LOS SCRIPTS ENTRAN EN EL EXE.
      Se embeben como recursos; no se escriben nunca en disco.
      Cambiar un .psm1 y recompilar es todo lo que hace falta.
    -->
    <EmbeddedResource Include="..\..\scripts\modules\Toolkit.Core.psm1"     LogicalName="Scripts/Toolkit.Core.psm1" />
    <EmbeddedResource Include="..\..\scripts\modules\Toolkit.Location.psm1" LogicalName="Scripts/Toolkit.Location.psm1" />
    <EmbeddedResource Include="..\..\scripts\modules\Toolkit.Apps.psm1"     LogicalName="Scripts/Toolkit.Apps.psm1" />
    <EmbeddedResource Include="..\..\scripts\modules\Toolkit.Network.psm1"  LogicalName="Scripts/Toolkit.Network.psm1" />
    <EmbeddedResource Include="..\..\scripts\modules\Toolkit.Users.psm1"    LogicalName="Scripts/Toolkit.Users.psm1" />
    <EmbeddedResource Include="..\..\scripts\modules\Toolkit.Support.psm1"  LogicalName="Scripts/Toolkit.Support.psm1" />
    <EmbeddedResource Include="..\..\scripts\Invoke-ToolkitRun.ps1"         LogicalName="Scripts/Invoke-ToolkitRun.ps1" />
    <EmbeddedResource Include="..\..\scripts\config\catalog.json"           LogicalName="Scripts/catalog.json" />
    <!-- El mismo icono, embebido para las ventanas (titulo, Alt+Tab, cabecera). -->
    <EmbeddedResource Include="..\..\assets\logo.ico"                        LogicalName="Assets/logo.ico" />
    <!-- Logo de la empresa para la cabecera de la ventana. -->
    <EmbeddedResource Include="..\..\assets\bpo-centers-logo.png"            LogicalName="Assets/bpo-centers-logo.png" />
  </ItemGroup>

</Project>
